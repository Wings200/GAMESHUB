{
  "name": "redline-multiplayer",
  "main": "worker.js",
  "compatibility_date": "2026-09-28",
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "RedlineRoom"
      },
      {
        "name": "DIRECTORY",
        "class_name": "RedlineDirectory"
      },
      {
        "name": "STATS",
        "class_name": "RedlineStats"
      }
    ]
  },
  "exports": {
    "RedlineRoom": {
      "type": "durable-object",
      "storage": "sqlite"
    },
    "RedlineDirectory": {
      "type": "durable-object",
      "storage": "sqlite"
    },
    "RedlineStats": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
